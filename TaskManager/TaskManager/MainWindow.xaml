<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="TaskManager.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TaskManager"
    xmlns:models="using:TaskManager.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:lottie="using:CommunityToolkit.WinUI.Lottie"
    mc:Ignorable="d"
    Title="TaskManager">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Background="#FFF9F0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Grid.Row="1" Grid.ColumnSpan="2" CornerRadius="25" 
        Padding="20" 
        Margin="0,0,0,0"
        BorderBrush="{StaticResource SecondaryKawaiiBrush}" 
        BorderThickness="2">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="15" Grid.Row="0" Margin="0,0,0,10" VerticalAlignment="Center">
            <AnimatedVisualPlayer x:Name="MascotPlayer" Width="60" Height="60" AutoPlay="True">
                <lottie:LottieVisualSource x:Name="MascotSource" UriSource="ms-appx:///Assets/Lottie/KawaiiMascot.json"/>
            </AnimatedVisualPlayer>

            <TextBox x:Name="SearchBox" 
             PlaceholderText="🔍 Search processes..." 
             Width="250" 
             VerticalAlignment="Center"
             CornerRadius="12"
             TextChanged="SearchBox_TextChanged"
             BorderThickness="2"
             Foreground="Black">    
                <TextBox.Resources>
                    <SolidColorBrush x:Key="TextControlBackground" Color="#E0BBE4"/>
                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#C48DC9"/>
                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#FFF9F0"/>
                    <SolidColorBrush x:Key="TextControlForeground" Color="#2D2D2D"/>
                    <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#2D2D2D"/>
                    <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#2D2D2D"/>

                    <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent"/>
                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#C48DC9"/>
                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#C48DC9"/>
                    <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#666666"/>
                    <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#444444"/>
                    <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#444444"/>
                </TextBox.Resources>
                <ToolTipService.ToolTip>
                    <ToolTip Content="Type here to filter your processes by name! 🔍" />
                </ToolTipService.ToolTip>
            </TextBox>

            <Button x:Name="RefreshButton" Click="RefreshButton_Click" 
            VerticalAlignment="Center" CornerRadius="10" Padding="12,5,12,5"
            Background="#AEC6CF" Foreground="Black">    
                <Button.Resources>
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#779ECB"/>
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#006CE6"/>
                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#E5EFFF"/>
                    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#E5EFFF"/>
                </Button.Resources>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <AnimatedVisualPlayer x:Name="RefreshLoadingPlayer" Width="30" Height="30" AutoPlay="False" Visibility="Collapsed">
                        <lottie:LottieVisualSource UriSource="ms-appx:///Assets/Lottie/LoadingFlower.json"/>
                    </AnimatedVisualPlayer>
                    <TextBlock x:Name="RefreshButtonText" Text="Refresh"/>
                </StackPanel>
                <ToolTipService.ToolTip>
                    <ToolTip Content="Here you can refresh the whole task manager ✨" />
                </ToolTipService.ToolTip>
            </Button>

            <Button x:Name="KillButton" Content="End Task" Click="KillButton_Click" 
            VerticalAlignment="Center" CornerRadius="10" Padding="12,5,12,5"
            Background="#FFD1DC" Foreground="Black">
                <Button.Resources>
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#FF69B4"/>
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#D1478B"/>
                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FFE3EF"/>
                    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#FFE3EF"/>
                </Button.Resources>
                <ToolTipService.ToolTip>
                    <ToolTip Content="If you select a process an click here, it is killed ✨" />
                </ToolTipService.ToolTip>
            </Button>

            <Border Grid.Column="1" Margin="20,0,0,0" Padding="15" Background="White" CornerRadius="20" BorderBrush="{StaticResource PrimaryKawaiiBrush}" BorderThickness="2">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <ToolTipService.ToolTip>
                        <ToolTip Content="This graph depicts the total CPU  and RAM useage,since you opened this Taskmanager." />
                    </ToolTipService.ToolTip>

                    <StackPanel Grid.Row="0" Margin="5" Width ="230" VerticalAlignment="Center">
                        <TextBlock Text="☁️ Total CPU" FontSize="12" Foreground="#779ECB" FontWeight="Bold"/>
                        <Canvas x:Name="CpuCanvas" Height="40" VerticalAlignment="Bottom" HorizontalAlignment="Stretch">
                            <Polyline x:Name="CpuGraphLine" Stroke="#779ECB" StrokeThickness="3" StrokeLineJoin="Round"/>
                            <TextBlock x:Name="CpuSparkle" Text="✨" Foreground="Gold" FontSize="16" Visibility="Collapsed"/>
                        </Canvas>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="5" Width ="230" VerticalAlignment="Center">
                        <TextBlock Text="☁️ Total RAM" FontSize="12" Foreground="#FFB7C5" FontWeight="Bold"/>
                        <Canvas x:Name="RamCanvas" Height="40" VerticalAlignment="Bottom" HorizontalAlignment="Stretch">
                            <Polyline x:Name="RamGraphLine" Stroke="#FFB7C5" StrokeThickness="3" StrokeLineJoin="Round"/>
                            <TextBlock x:Name="RamSparkle" Text="✧" Foreground="#FF69B4" FontSize="18" Visibility="Collapsed"/>
                        </Canvas>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>


        <Border Grid.Row="1" Background="White" CornerRadius="25" Padding="25" BorderBrush="{StaticResource SecondaryKawaiiBrush}" BorderThickness="2">
            <ListView x:Name="ProcessListView" 
                      ItemsSource="{x:Bind ViewModel.Processes, Mode=OneWay}" 
                      Header="{x:Bind ViewModel, Mode=OneWay}"
                      SelectionMode="Extended" 
                      Background="Transparent" 
                      SelectionChanged="ProcessListView_SelectionChanged">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsStackPanel ItemsUpdatingScrollMode="KeepItemsInView" />
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.Resources>
                    <SolidColorBrush x:Key="ListViewItemForeground" Color="#4A4A4A"/>
                    <SolidColorBrush x:Key="ListViewItemForegroundPointerOver" Color="#FF69B4"/>
                    <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#E0BBE4"/>
                    <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="#FFF0F5"/>
                    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#D6A4DC"/>

                    <Style x:Key="KawaiiThumbStyle" TargetType="Thumb">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Thumb">
                                    <TextBlock Text="♥" Foreground="#FF69B4" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>

                    <Style TargetType="ScrollBar">
                        <Setter Property="Background" Value="Transparent"/>
                    </Style>
                    <SolidColorBrush x:Key="ScrollBarThumbFillPointerOver" Color="#FF69B4"/>
                    <SolidColorBrush x:Key="ScrollBarThumbFill" Color="#FFD1DC"/>
                </ListView.Resources>

                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="CornerRadius" Value="15"/>
                        <Setter Property="Margin" Value="0,2,0,2"/>
                    </Style>
                </ListView.ItemContainerStyle>

                <ListView.HeaderTemplate>
                    <DataTemplate x:DataType="local:MainViewModel">
                        <Grid Margin="12,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="250"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="90"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="🌸 Process" FontSize="12" Foreground="#779ECB" FontWeight="Bold" Grid.Column="0">
                <ToolTipService.ToolTip>
                    <ToolTip Content="This is the process name." />
                </ToolTipService.ToolTip>
                            </TextBlock>

                            <TextBlock Text="#" FontWeight="Bold" Grid.Column="1" />

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="⚡ CPU" FontSize="12" Foreground="#779ECB" FontWeight="Bold" />
                                <TextBlock Text="{x:Bind TotalCpuDisplay, Mode=OneWay}" 
                           FontSize="12" Foreground="#779ECB" FontWeight="Normal"/>
                                <ToolTipService.ToolTip>
                                    <ToolTip Content="This is the total CPU Usage." />
                                </ToolTipService.ToolTip>
                            </StackPanel>

                            <StackPanel Grid.Column="3">
                                <TextBlock Text="🧠 RAM" FontSize="12" Foreground="#779ECB" FontWeight="Bold" />
                                <TextBlock Text="{x:Bind TotalRamDisplay, Mode=OneWay}" 
                           FontSize="12" Foreground="#FFB7C5" FontWeight="Normal"/>
                                <ToolTipService.ToolTip>
                                    <ToolTip Content="This is the total RAM Usage." />
                                </ToolTipService.ToolTip>
                            </StackPanel>

                            <TextBlock Text="✨ Status" FontSize="12" Foreground="#779ECB" FontWeight="Bold" Grid.Column="4">  
                <ToolTipService.ToolTip>
                    <ToolTip Content="This is the Status of the process." />
                </ToolTipService.ToolTip>
                            </TextBlock>
                        </Grid>
                    </DataTemplate>
                </ListView.HeaderTemplate>
                
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:ProcessItem">
                        <Grid Height="45">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="250"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="90"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Grid.Column="0" Spacing="12">
                                <Image Source="{x:Bind IconSource, Mode=OneWay}" Width="28" Height="28" VerticalAlignment="Center"/>
                                <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center" FontSize="14" FontWeight="Medium"/>
                            </StackPanel>

                            <Button Grid.Column="1" 
                                VerticalAlignment="Center" 
                                HorizontalAlignment="Center"
                                Padding="8,2"
                                Background="#E0BBE4" 
                                CornerRadius="10"
                                BorderThickness="0">

                                <Button.Resources>
                                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#FF69B4"/>
                                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#D1478B"/>
                                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FFE3EF"/>
                                    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#FFE3EF"/>
                                </Button.Resources>

                                <ToolTipService.ToolTip>
                                    <ToolTip Content="This is the number of subprocesses. Click for more info! ✨" />
                                </ToolTipService.ToolTip>

                                <Button.Content>
                                    <TextBlock Text="{x:Bind PidCount, Mode=OneWay}" 
                                       Foreground="White" 
                                       FontWeight="Bold"/>
                                </Button.Content>

                                <Button.Flyout>
                                    <Flyout Opening="Flyout_Opening" Closed="Flyout_Closed">
                                        <Flyout.FlyoutPresenterStyle>
                                            <Style TargetType="FlyoutPresenter">
                                                <Setter Property="Background" Value="White"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource PrimaryKawaiiBrush}"/>
                                                <Setter Property="BorderThickness" Value="2"/>
                                                <Setter Property="CornerRadius" Value="15"/>
                                                <Setter Property="Padding" Value="15"/>
                                            </Style>
                                        </Flyout.FlyoutPresenterStyle>

                                        <StackPanel Spacing="10" MinWidth="250">
                                            <TextBlock Text="🌸 Subprocess Details" FontWeight="Bold" Foreground="#FF69B4" FontSize="16"/>

                                            <Grid Margin="0,5,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="60"/>
                                                    <ColumnDefinition Width="70"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="PID" FontWeight="Bold" FontSize="11" Grid.Column="0" Foreground="Gray"/>
                                                <TextBlock Text="CPU" FontWeight="Bold" FontSize="11" Grid.Column="1" Foreground="Gray"/>
                                                <TextBlock Text="RAM" FontWeight="Bold" FontSize="11" Grid.Column="2" Foreground="Gray"/>
                                            </Grid>

                                            <Border Height="1" Background="#FFD1DC"/>

                                            <ItemsControl ItemsSource="{Binding SubProcesses}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="models:SubProcessInfo">
                                                        <Grid Margin="0,2">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="60"/>
                                                                <ColumnDefinition Width="70"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Pid}" FontSize="11" Grid.Column="0" Foreground="#AEC6CF"/>
                                                            <TextBlock Text="{Binding CpuDisplay}" FontSize="11" Grid.Column="1" FontWeight="Medium"/>
                                                            <TextBlock Text="{Binding Memory}" FontSize="11" Grid.Column="2" HorizontalAlignment="Right"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <TextBlock Text="✨ Live updates active" FontSize="9" HorizontalAlignment="Center" Foreground="LightGray" Margin="0,10,0,0"/>
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                            
                            <TextBlock Text="{x:Bind CpuUsageDisplay, Mode=OneWay}" Grid.Column="2" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind MemoryUsage, Mode=OneWay}" Grid.Column="3" VerticalAlignment="Center"/>
                            <TextBlock Text="{x:Bind Status, Mode=OneWay}" Grid.Column="4" VerticalAlignment="Center"/>

                            <AnimatedVisualPlayer x:Name="HeartBurstPlayer" 
                                                  Grid.Column="5" 
                                                  Width="80" Height="80" 
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  AutoPlay="False" 
                                                  Visibility="Collapsed"
                                                  Canvas.ZIndex="10">
                                <lottie:LottieVisualSource UriSource="ms-appx:///Assets/Lottie/HeartBurst.json"/>
                            </AnimatedVisualPlayer>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>
    </Grid>
</Window>