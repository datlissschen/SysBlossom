<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="TaskManager.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TaskManager">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- Other merged dictionaries here -->
            </ResourceDictionary.MergedDictionaries>
            <!-- Other app resources here -->
            <Color x:Key="KawaiiPink">#FFD1DC</Color>
            <Color x:Key="KawaiiBlue">#AEC6CF</Color>
            <Color x:Key="KawaiiPurple">#E0BBE4</Color>
            <Color x:Key="KawaiiMint">#B2F2BB</Color>

            <SolidColorBrush x:Key="PrimaryKawaiiBrush" Color="{StaticResource KawaiiPink}"/>
            <SolidColorBrush x:Key="SecondaryKawaiiBrush" Color="{StaticResource KawaiiBlue}"/>

            <CornerRadius x:Key="ControlCornerRadius">12</CornerRadius>

            <Style TargetType="ToolTip">
                <Setter Property="Background" Value="White" />
                <Setter Property="BorderBrush" Value="{StaticResource PrimaryKawaiiBrush}" />
                <Setter Property="BorderThickness" Value="2" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="10,5" />
                <Setter Property="Foreground" Value="#4A4A4A" />
                <Setter Property="FontSize" Value="12" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
